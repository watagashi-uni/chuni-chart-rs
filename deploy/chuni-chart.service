[Unit]
Description=Chuni Chart native renderer
After=network.target

[Service]
Type=simple
User=chuni-chart
Group=chuni-chart
ExecStart=/opt/chuni-chart/bin/chuni-chart-rs serve --config /etc/chuni-chart/config.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
MemoryHigh=1G
MemoryMax=1536M
MemorySwapMax=0
TasksMax=64
CPUQuota=400%
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
